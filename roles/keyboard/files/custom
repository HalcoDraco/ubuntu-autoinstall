// ===========================================================================
// /usr/share/X11/xkb/symbols/custom
//
// US layout + AltGr (right-Alt) mappings for Spanish characters.
//
// These mappings were recovered from the hand-edited
// /usr/share/X11/xkb/symbols/us on Niaura-linux, by diffing it against the
// pristine file from the xkb-data package. All 14 customised keys are here.
//
// WHY THIS FILE IS NAMED "custom":
// xkeyboard-config RESERVES the layout name "custom": it is listed in
// evdev.xml as "A user-defined custom Layout", but the package deliberately
// ships no symbols file for it. No package owns this path, so package updates
// CANNOT overwrite it.
//
// That is the fix for the actual problem: editing symbols/us worked, but that
// file belongs to the xkb-data package and gets replaced on every update --
// which is why the mappings kept disappearing.
// ===========================================================================

default partial alphanumeric_keys modifier_keys
xkb_symbols "basic" {

    // Start from the stock US layout, then override only the 14 keys below.
    // Because we only override, any future improvement upstream makes to the
    // US layout is inherited automatically.
    include "us(basic)"

    // Make RIGHT Alt act as AltGr (the "level 3" shift). Without this, the
    // third and fourth entries on each key below are unreachable.
    //
    // The old symbols/us edit did NOT include this -- it worked only because
    // the Spanish layout, loaded as the second group, happened to provide it.
    // Declaring it here makes this layout self-contained and correct even if
    // it is the only layout installed.
    include "level3(ralt_switch)"

    name[Group1] = "English (US, Spanish AltGr)";

    // Each key lists:  [ plain, Shift, AltGr, AltGr+Shift ]

    // --- accented vowels -------------------------------------------------
    key <AC01> {[         a,          A,     aacute,     Aacute ]};  // AltGr+a
    key <AD03> {[         e,          E,     eacute,     Eacute ]};  // AltGr+e
    key <AD08> {[         i,          I,     iacute,     Iacute ]};  // AltGr+i
    key <AD09> {[         o,          O,     oacute,     Oacute ]};  // AltGr+o
    key <AD07> {[         u,          U,     uacute,     Uacute ]};  // AltGr+u

    // --- Spanish letters --------------------------------------------------
    key <AC10> {[ semicolon,      colon,     ntilde,     Ntilde ]};  // AltGr+;  -> n-tilde
    key <BKSL> {[ backslash,        bar,   ccedilla,   Ccedilla ]};  // AltGr+\  -> c-cedilla

    // --- Spanish punctuation ---------------------------------------------
    key <AE01> {[         1,     exclam, exclamdown             ]};  // AltGr+1  -> inverted !
    key <AB10> {[     slash,   question, questiondown           ]};  // AltGr+/  -> inverted ?
    key <AE03> {[         3, numbersign, periodcentered         ]};  // AltGr+3  -> middle dot
    key <TLDE> {[     grave, asciitilde,  masculine, ordfeminine ]}; // AltGr+`  -> masculine/feminine ordinals

    // --- dead keys (press, then a vowel) ----------------------------------
    key <AD11> {[ bracketleft,  braceleft,  dead_grave          ]};  // AltGr+[  -> grave accent
    key <AC11> {[ apostrophe,    quotedbl, dead_diaeresis       ]};  // AltGr+'  -> diaeresis (u-umlaut)

    // --- currency ----------------------------------------------------------
    key <AC03> {[         d,          D,   EuroSign             ]};  // AltGr+d  -> euro
};

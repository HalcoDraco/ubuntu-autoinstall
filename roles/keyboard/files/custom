// ===========================================================================
// /usr/share/X11/xkb/symbols/custom
//
// A US layout with AltGr mappings for Spanish characters.
//
// WHY THIS FILE IS CALLED "custom":
// xkeyboard-config RESERVES the layout name "custom". It is listed in
// /usr/share/X11/xkb/rules/evdev.xml as "A user-defined custom Layout", but
// the package deliberately ships NO symbols file for it. That means this file
// is yours: package updates never overwrite it, because no package owns it.
//
// This is why you must not edit symbols/us -- that file IS owned by
// xkeyboard-config and gets clobbered on every update.
//
// ---------------------------------------------------------------------------
// TODO: REPLACE THE MAPPINGS BELOW WITH THE REAL ONES.
//
// The single ntilde mapping is a working placeholder so the layout is valid
// and selectable today. Add further keys inside the xkb_symbols block using
// the same pattern:
//
//     key <KEYCODE> {
//         type[Group1] = "FOUR_LEVEL_SEMIALPHABETIC",
//         [ plain, shifted, altgr, altgr_shifted ]
//     };
//
// Useful keycodes on a US layout:
//   <AD01>..<AD10>  the QWERTYUIOP row
//   <AC01>..<AC11>  the ASDFGHJKL;' row
//   <AB01>..<AB10>  the ZXCVBNM,./ row
//   <AE01>..<AE12>  the number row
//
// Find a key's code with:   xev -event keyboard    (or `wev` on Wayland)
// Find a character's name:  look it up in /usr/include/X11/keysymdef.h
//                           (strip the leading XK_ ; e.g. XK_ntilde -> ntilde)
//
// After editing, apply with:  ansible-playbook local.yml -K --tags keyboard
// then LOG OUT AND BACK IN -- see the manual steps the playbook prints.
// ---------------------------------------------------------------------------

default partial alphanumeric_keys
xkb_symbols "basic" {

    // Start from the standard US layout and change only what we need.
    include "us(basic)"

    // Make the RIGHT Alt key act as AltGr (the "level 3" shift).
    // Without this line the third and fourth entries in each key definition
    // below are unreachable.
    include "level3(ralt_switch)"

    name[Group1] = "English (custom, Spanish AltGr)";

    // ---- Spanish characters -------------------------------------------
    // AltGr + ;  ->  n-tilde
    // The four values are: [ plain, Shift, AltGr, AltGr+Shift ]
    //
    // FOUR_LEVEL_SEMIALPHABETIC is the key type that makes Caps Lock behave
    // sensibly for the letter-producing levels while leaving the punctuation
    // levels alone. Using the default type here would make AltGr+; dead.
    key <AC10> {
        type[Group1] = "FOUR_LEVEL_SEMIALPHABETIC",
        [ semicolon, colon, ntilde, Ntilde ]
    };

    // TODO: add the remaining mappings here.
};
